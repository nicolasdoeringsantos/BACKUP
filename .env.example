# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA compartilhe o arquivo .env preenchido (ele contém sua chave de API).

# Chave da API do MSP Clouds (Configurações > API no portal web)
MSPCLOUDS_API_KEY=sua_chave_real_aqui

# De quantos em quantos minutos o painel busca dados novos na API
FETCH_INTERVAL_MINUTES=30

# Depois de quantas horas sem um backup com SUCESSO um item é marcado como "Atrasado"
STALE_HOURS=26
